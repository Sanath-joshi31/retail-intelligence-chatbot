# AI Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
API_KEY=retail-intelligence-ai-secret-key
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:3000

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/retail-intelligence
MONGODB_DB_NAME=retail-intelligence

# Node.js API Gateway URL
NODE_BACKEND_URL=http://localhost:5000/api
