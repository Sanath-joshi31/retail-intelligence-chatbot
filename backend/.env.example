# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/retail-intelligence
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/retail-intelligence

# AI Service Configuration (FastAPI + LangGraph + RAG)
AI_SERVICE_URL=http://localhost:8000/ai

# OpenAI API Key (optional - app uses Python AI service / local fallback)
OPENAI_API_KEY=your-openai-api-key-here

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,exp://

# JWT Secret (for future auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
